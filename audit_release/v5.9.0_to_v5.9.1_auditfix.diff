+def _estimator_measurement_metadata(name):
+    """Semantic type and plain-language meaning for one of the 29 outputs."""
+    kind = ESTIMATOR_D_KIND[name]
+    info = dict(D_KIND_REGISTRY[kind])
+    info.update({
+        "d_kind": kind,
+        "tlog_eligible": name in {
+            estimator for members in DIMENSION_FOR_TLOG.values() for estimator in members
+        },
+        "tlog_membership": (
+            "existing_geometric_layer" if name in {
+                estimator for members in DIMENSION_FOR_TLOG.values() for estimator in members
+            } else "signature_only"
+        ),
+    })
+    return info
+
+ESTIMATOR_MEASUREMENT_TYPES = {
+    name: _estimator_measurement_metadata(name) for name in ESTIMATOR_NAMES
+}
+
+def _check_estimator_measurement_types():
+    if set(ESTIMATOR_D_KIND) != set(ESTIMATOR_NAMES):
+        missing = sorted(set(ESTIMATOR_NAMES) - set(ESTIMATOR_D_KIND))
+        extra = sorted(set(ESTIMATOR_D_KIND) - set(ESTIMATOR_NAMES))
+        raise ValueError(f"Taxonomie d_kind des 29 invalide; manquants={missing}, extra={extra}")
+    if any(kind not in D_KIND_REGISTRY for kind in ESTIMATOR_D_KIND.values()):
+        raise ValueError("d_kind sans définition dans D_KIND_REGISTRY")
+    tlog_names = {name for members in DIMENSION_FOR_TLOG.values() for name in members}
+    typed_dimensions = {
+        name for name, kind in ESTIMATOR_D_KIND.items()
+        if D_KIND_REGISTRY[kind]["quantity_type"] == "dimension_proxy"
+    }
+    if typed_dimensions != tlog_names:
+        raise ValueError(
+            "Les types sémantiques dimension/signature ne concordent pas avec DIMENSION_FOR_TLOG; "
+            f"écart={sorted(typed_dimensions ^ tlog_names)}"
+        )
+
+_check_estimator_measurement_types()
